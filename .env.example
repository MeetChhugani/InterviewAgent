LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GROQ_API_KEY=
# Protects the recruiter dashboard at /admin. Use a long random value in
# production; the browser sends it only as an X-Admin-Key header.
ADMIN_ACCESS_KEY=
# HR portal sign-in at /hr-login. Do not use the sample password in production.
HR_LOGIN_EMAIL=hr@interviewos.com
HR_LOGIN_PASSWORD=
# SQLite file location. On Railway, point this inside a mounted Volume, e.g.
# /data/interviewos.db, otherwise data is lost whenever a container is replaced.
DATABASE_PATH=interviewos.db
# Supabase is used by the FastAPI server only. Never put SUPABASE_SECRET_KEY
# into Vercel or any frontend environment variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Required only when the LiveKit worker runs separately from the FastAPI API
# (for example, as a separate Railway service).
# INTERVIEW_API_URL=https://your-api.up.railway.app
ELEVENLABS_API_KEY=
# LiveKit Inference is the default reliable public-demo voice. Set "gnani" or
# "elevenlabs" only after verifying the corresponding provider account.
INTERVIEW_TTS_PROVIDER=inference
# A professional male Aura-2 voice for LiveKit Inference.
LIVEKIT_TTS_VOICE=odysseus
# Optional: use your preferred male ElevenLabs voice ID.
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
GNANI_API_KEY=
GNANI_TTS_VOICE=Vikrant
# Use "hinglish" for Roman Hindi + English questions, or "english" for Indian English.
# "bilingual" randomly mixes English and Hindi (Devanagari) questions.
# With a 10-question screening, it asks exactly 5 English and 5 Hindi questions.
INTERVIEW_LANGUAGE_MODE=bilingual

# Temporary public demo only: set this to the frontend tunnel URL.
# DEMO_FRONTEND_ORIGIN=https://your-demo.trycloudflare.com
# DEMO_ALLOW_TUNNEL_ORIGINS=true
